{
    "name": "uy-catastro-mcp-server",
    "version": "2.0.0",
    "private": true,
    "type": "module",
    "description": "Servidor MCP de Catastro Uruguay para ChatGPT",
    "scripts": {
        "build:code": "esbuild src/server.ts src/ingest.ts --bundle --platform=node --format=esm --outdir=dist --packages=external",
        "ingest": "node dist/ingest.js",
        "build": "npm run build:code && npm run ingest",
        "start": "node dist/server.js",
        "test": "node --import tsx --test test/*.test.ts",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.17.5",
        "better-sqlite3": "^12.2.0",
        "csv-parse": "^6.1.0",
        "iconv-lite": "^0.7.0",
        "unzipper": "^0.12.3",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^24.3.0",
        "@types/unzipper": "^0.10.11",
        "esbuild": "^0.24.0",
        "tsx": "^4.20.5",
        "typescript": "^5.9.2"
    }
}
